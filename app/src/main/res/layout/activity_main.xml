<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" Talia Królestwa Północy"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Wpisz nazwe karty..."
             />

        <EditText
            android:id="@+id/etPower"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="wpisz sile karty"
            android:inputType="number" />

        <CheckBox
            android:id="@+id/cbIsHero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Karta Bohatera (Hero)"
            android:layout_marginTop="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rząd / Typ jednostki:"
            android:layout_marginTop="12dp"/>

        <Spinner
            android:id="@+id/spUnitType"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            />

        <Button
            android:id="@+id/btnAdd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dodaj"
            android:layout_marginTop="16dp"/>

    <ListView
        android:id="@+id/listViewCards"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />


</LinearLayout>